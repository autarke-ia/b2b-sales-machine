# Banco — credenciais vindas do dono (RDS mindville_db, banco dedicado b2b_sales_machine_dev).
# NUNCA versionar valores reais; este arquivo lista apenas nomes.
DATABASE_URL=
# Credencial separada de migrations (owner) — nunca na configuração cotidiana da API.
DATABASE_MIGRATION_URL=
# Papel e senha da aplicação, usados por scripts/bootstrap-db.ts e db:setup.
# Os papéis e o banco são provisionados UMA VEZ por um superusuário (least-privilege:
# owner sem CREATEROLE); o bootstrap só os verifica no fluxo cotidiano.
APP_DB_ROLE=b2bsm_app
APP_DB_PASSWORD=

# Sessão/CSRF
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000

# IA — adaptador OpenAI-compatible; sem chave, o provider fixture é exigido explicitamente.
AI_PROVIDER=fixture
AI_MODEL=
AI_API_KEY=

# Seed de usuários de desenvolvimento (formato JSON: [{"email":"...","name":"...","password":"..."}])
SEED_USERS=

# Limites de job de IA (defaults da spec)
AI_JOB_MAX_COMPANIES=100
AI_JOB_CONCURRENCY=2
AI_JOB_TIMEOUT_SECONDS=90
