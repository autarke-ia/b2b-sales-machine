{
  "name": "b2b-sales-machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:reset-demo": "tsx prisma/seed/reset-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.3.1",
    "dotenv": "17.4.2",
    "lucide-react": "1.50.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.28",
    "prisma": "6.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
